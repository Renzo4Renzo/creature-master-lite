generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String  @id @default(uuid())
  username  String  @unique
  email     String  @unique
  password  String
  isAI      Boolean @default(false)

  decks     Deck[]
  turns     Turn[]
  turnPhases TurnPhase[]

  liveGamesP1 LiveGame[] @relation("live_game_player1")
  liveGamesP2 LiveGame[] @relation("live_game_player2")

  completedMatchesP1 CompletedMatch[] @relation("completed_match_player1")
  completedMatchesP2 CompletedMatch[] @relation("completed_match_player2")

  friendships1 Friendship[] @relation("player_friends_1")
  friendships2 Friendship[] @relation("player_friends_2")

  matchmakingEntries MatchmakingQueue[]
  gameCreatures GameCreature[]
  gameHeroes GameHero[]
}

model Deck {
  id        String @id @default(uuid())
  playerId  String
  name      String
  hero      DeckHero?
  creatures DeckCreature[]

  player    Player @relation(fields: [playerId], references: [id])
}

model DeckHero {
  id        String @id @default(uuid())
  deckId    String @unique
  heroId    String

  deck      Deck @relation(fields: [deckId], references: [id])
  hero      Hero @relation(fields: [heroId], references: [id])
}

model DeckCreature {
  id        String @id @default(uuid())
  deckId    String
  creatureId String
  quantity  Int @default(1)

  deck      Deck @relation(fields: [deckId], references: [id])
  creature  Creature @relation(fields: [creatureId], references: [id])
}

model Friendship {
  id        String  @id @default(uuid())
  player1Id String
  player2Id String
  createdAt DateTime @default(now())

  player1   Player @relation("player_friends_1", fields: [player1Id], references: [id])
  player2   Player @relation("player_friends_2", fields: [player2Id], references: [id])

  @@unique([player1Id, player2Id])
}

model MatchmakingQueue {
  id        String  @id @default(uuid())
  playerId  String
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id])
  
  @@index([createdAt]) // Indexing for quicker expiration queries
}

model LiveGame {
  id           String  @id @default(uuid())
  player1Id    String
  player2Id    String
  currentTurn  Int     @default(1)
  status       String  @default("ongoing")
  winnerId     String?
  lifePointsP1 Int     @default(10)
  lifePointsP2 Int     @default(10)
  createdAt    DateTime @default(now())

  player1      Player @relation("live_game_player1", fields: [player1Id], references: [id])
  player2      Player @relation("live_game_player2", fields: [player2Id], references: [id])
  turns        Turn[]
  gameCreatures GameCreature[]
  gameHeroes   GameHero[]

  @@index([player1Id, player2Id])
}

model Turn {
  id          String  @id @default(uuid())
  gameId      String
  playerId    String
  turnNumber  Int
  phases      TurnPhase[]
  createdAt   DateTime @default(now())

  game        LiveGame @relation(fields: [gameId], references: [id])
  player      Player @relation(fields: [playerId], references: [id])

  @@index([gameId, playerId])
}

model TurnPhase {
  id          String  @id @default(uuid())
  turnId      String
  playerId    String
  phase       String
  createdAt   DateTime @default(now())

  turn        Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  player      Player @relation(fields: [playerId], references: [id])

  @@index([turnId, playerId])
}

model CompletedMatch {
  id         String  @id @default(uuid())
  player1Id  String
  player2Id  String
  winnerId   String?
  gameData   Json
  createdAt  DateTime @default(now())

  player1    Player @relation("completed_match_player1", fields: [player1Id], references: [id])
  player2    Player @relation("completed_match_player2", fields: [player2Id], references: [id])
}

model Creature {
  id              String @id @default(uuid())
  name            String @unique
  health          Int
  temperament     String
  imageUrl        String
  abilities       CreatureAbility[]

  decks           DeckCreature[]
  gameCreatures   GameCreature[]
}

model Hero {
  id          String @id @default(uuid())
  name        String @unique
  imageUrl    String
  abilities   HeroAbility[]

  decks       DeckHero[]
  gameHero    GameHero?
}

model Ability {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  creatureAbilities CreatureAbility[]
  heroAbilities     HeroAbility[]
  gameCardAbilities GameCardAbility[]
}

model AbilityAction {
  id                String  @id @default(uuid())
  creatureAbilityId String
  action            String
  dynamicQty        Boolean

  creatureAbility   CreatureAbility @relation(fields: [creatureAbilityId], references: [id], onDelete: Cascade, name: "CreatureAbility_AbilityActions")
}

model CreatureAbility {
  id                String @id @default(uuid())
  creatureId        String
  abilityId         String
  trigger           String
  targetType        String
  targetOwner       String
  targetLocation    String
  singleUse         Boolean @default(false)

  abilitiesActions  AbilityAction[] @relation("CreatureAbility_AbilityActions")

  creature          Creature @relation(fields: [creatureId], references: [id])
  ability           Ability  @relation(fields: [abilityId], references: [id])

  @@unique([creatureId, abilityId])
}

model HeroAbility {
  id          String @id @default(uuid())
  heroId      String
  abilityId   String
  conditions  Json

  hero        Hero @relation(fields: [heroId], references: [id])
  ability     Ability @relation(fields: [abilityId], references: [id])
}

model GameCreature {
  id         String @id @default(uuid())
  gameId     String
  creatureId String
  ownerId    String
  health     Int
  energy     Int?
  abilities  GameCardAbility[]

  game       LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  creature   Creature @relation(fields: [creatureId], references: [id])
  owner      Player @relation(fields: [ownerId], references: [id])
}

model GameHero {
  id         String @id @default(uuid())
  gameId     String
  heroId     String @unique
  ownerId    String
  energy     Int
  abilities  GameCardAbility[]

  game       LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hero       Hero @relation(fields: [heroId], references: [id])
  owner      Player @relation(fields: [ownerId], references: [id])
}

model GameCardAbility {
  id           String  @id @default(uuid())
  gameCreatureId String?
  gameHeroId    String?
  abilityId    String
  used         Boolean @default(false)

  gameCreature GameCreature? @relation(fields: [gameCreatureId], references: [id])
  gameHero     GameHero? @relation(fields: [gameHeroId], references: [id])
  ability      Ability @relation(fields: [abilityId], references: [id])
}
