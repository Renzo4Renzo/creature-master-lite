generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String  @id @default(uuid())
  username  String  @unique
  email     String  @unique
  password  String
  isAI      Boolean @default(false)

  decks     Deck[]
  liveGamesP1 Game[] @relation("game_player1")
  liveGamesP2 Game[] @relation("game_player2")
  friendships1 Friendship[] @relation("player_friends_1")
  friendships2 Friendship[] @relation("player_friends_2")
  matchmakingEntries MatchmakingQueue[]
  creaturesInGame CreatureInGame[]
  heroesInGame HeroInGame[]
  turns Turn[]
  turnPhases TurnPhase[]
}

model Deck {
  id        String @id @default(uuid())
  playerId  String
  name      String
  hero      DeckHero?
  creatures DeckCreature[]

  player    Player @relation(fields: [playerId], references: [id])
}

model DeckHero {
  id        String @id @default(uuid())
  deckId    String @unique
  heroId    String

  deck      Deck @relation(fields: [deckId], references: [id])
  hero      Hero @relation(fields: [heroId], references: [id])
}

model DeckCreature {
  id         String @id @default(uuid())
  deckId     String
  creatureId String
  quantity   Int @default(1)

  deck       Deck @relation(fields: [deckId], references: [id])
  creature   Creature @relation(fields: [creatureId], references: [id])
}

model Creature {
  id              String @id @default(uuid())
  name            String @unique
  health          Int
  storage         Int
  imageUrl        String
  abilities       Ability[]

  decks           DeckCreature[]
  creaturesInGame CreatureInGame[]
}

model Hero {
  id          String @id @default(uuid())
  name        String @unique
  imageUrl    String

  decks       DeckHero[]
  heroesInGame HeroInGame[]
  abilityOptions HeroAbilityOption[]
}

model Ability {
  id              String @id @default(uuid())
  name            String @unique
  description     String?
  quality         AbilityQuality
  creatureId      String
  trigger         AbilityTrigger
  targetType      TargetType
  targetOwner     TargetOwner
  targetLocation  TargetLocation
  value           Int @default(0)
  singleUse       Boolean @default(false)
  actions         AbilityAction[]
  abilityOptions  HeroAbilityOption[]
  inGame          AbilityInGame[]

  creature       Creature @relation(fields: [creatureId], references: [id])
}

model AbilityAction {
  id           String @id @default(uuid())
  abilityId    String
  action       AbilityActionType
  dynamicValue Boolean @default(true)

  ability    Ability @relation(fields: [abilityId], references: [id], onDelete: Cascade)
}

model HeroAbilityOption {
  id        String @id @default(uuid())
  heroId    String
  abilityId String
  cost      Int

  hero      Hero    @relation(fields: [heroId], references: [id])
  ability   Ability @relation(fields: [abilityId], references: [id])
}

model AbilityInGame {
  id              String  @id @default(uuid())
  creatureInGameId String
  abilityId       String
  used            Boolean @default(false)
  grantedByHero   Boolean @default(false)

  creatureInGame  CreatureInGame @relation(fields: [creatureInGameId], references: [id])
  ability         Ability         @relation(fields: [abilityId], references: [id])
}

model Game {
  id           String @id @default(uuid())
  player1Id    String
  player2Id    String
  currentTurn  Int @default(1)
  status       String @default("ongoing")
  winnerId     String?
  stashP1      Int @default(10)
  stashP2      Int @default(10)
  createdAt    DateTime @default(now())

  player1      Player @relation("game_player1", fields: [player1Id], references: [id])
  player2      Player @relation("game_player2", fields: [player2Id], references: [id])
  turns        Turn[]
  creatures    CreatureInGame[]
  heroes       HeroInGame[]

  @@index([player1Id, player2Id])
  @@index([status, createdAt])
}

model CreatureInGame {
  id         String @id @default(uuid())
  gameId     String
  creatureId String
  ownerId    String
  health     Int
  storage    Int
  row        Int
  column     Int
  abilities  AbilityInGame[]

  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  creature   Creature @relation(fields: [creatureId], references: [id])
  owner      Player   @relation(fields: [ownerId], references: [id])
}

model HeroInGame {
  id        String @id @default(uuid())
  gameId    String
  heroId    String
  ownerId   String
  energy    Int

  game      Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  hero      Hero  @relation(fields: [heroId], references: [id])
  owner     Player @relation(fields: [ownerId], references: [id])
}

model Turn {
  id          String  @id @default(uuid())
  gameId      String
  playerId    String
  turnNumber  Int
  phases      TurnPhase[]
  createdAt   DateTime @default(now())

  game        Game @relation(fields: [gameId], references: [id])
  player      Player @relation(fields: [playerId], references: [id])
}

model TurnPhase {
  id          String  @id @default(uuid())
  turnId      String
  playerId    String
  phase       String
  createdAt   DateTime @default(now())

  turn        Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  player      Player @relation(fields: [playerId], references: [id])
}

model Friendship {
  id        String  @id @default(uuid())
  player1Id String
  player2Id String
  createdAt DateTime @default(now())

  player1   Player @relation("player_friends_1", fields: [player1Id], references: [id])
  player2   Player @relation("player_friends_2", fields: [player2Id], references: [id])

  @@unique([player1Id, player2Id])
}

model MatchmakingQueue {
  id        String  @id @default(uuid())
  playerId  String
  createdAt DateTime @default(now())

  player    Player @relation(fields: [playerId], references: [id])

  @@index([createdAt])
  @@index([createdAt, playerId])
  @@unique([playerId])
}

enum AbilityQuality {
  REGULAR
  BEST
}

enum AbilityTrigger {
  RECRUITMENT_ASSIGNMENT
  ROLLING_DICE
  ENTERING_BATTLE
  WINNING_BATTLE
  DYING_IN_BATTLE
}

enum TargetType {
  CREATURE
  HERO
}

enum TargetOwner {
  ONESELF
  ENEMY
}

enum TargetLocation {
  CURRENT_ALLY
  CURRENT_ENEMY
  ENEMY_FIELD
  OWN_HERO_ZONE
  ENEMY_HERO_ZONE
}

enum AbilityActionType {
  HEALTH_UPDATE
  STORAGE_UPDATE
  DICE_UPDATE
  ASK_IF_REROLL
  DICE_REROLL
  ENERGY_UPDATE
  NO_BATTLE_DAMAGE
  DISCARD
  CANT_MOVE
  RETURN_TO_HAND
}
