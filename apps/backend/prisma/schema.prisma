generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String  @id @default(uuid())
  username  String  @unique
  email     String  @unique
  password  String
  isAI      Boolean @default(false) // AI opponents (false = human, true = bot)

  decks     Deck[]
  turns     Turn[]
  turnPhases TurnPhase[]

  liveGamesP1 LiveGame[] @relation("live_game_player1")
  liveGamesP2 LiveGame[] @relation("live_game_player2")

  completedMatchesP1 CompletedMatch[] @relation("completed_match_player1")
  completedMatchesP2 CompletedMatch[] @relation("completed_match_player2")

  friendships1 Friendship[] @relation("player_friends_1")
  friendships2 Friendship[] @relation("player_friends_2")

  matchmakingEntries MatchmakingQueue[]
  gameCards GameCard[]
}

model Friendship {
  id        String  @id @default(uuid())
  player1Id String
  player2Id String
  createdAt DateTime @default(now())

  player1   Player @relation("player_friends_1", fields: [player1Id], references: [id])
  player2   Player @relation("player_friends_2", fields: [player2Id], references: [id])

  @@unique([player1Id, player2Id]) // Prevents duplicate friendships
}

model MatchmakingQueue {
  id        String  @id @default(uuid())
  playerId  String
  createdAt DateTime @default(now()) // Used for 60s timeout logic

  player    Player @relation(fields: [playerId], references: [id])
}

model LiveGame {
  id           String  @id @default(uuid())
  player1Id    String
  player2Id    String
  currentTurn  Int     @default(1)
  status       String  @default("ongoing") // "ongoing", "finished"
  winnerId     String?
  lifePointsP1 Int     @default(10)
  lifePointsP2 Int     @default(10)
  createdAt    DateTime @default(now())

  player1      Player @relation("live_game_player1", fields: [player1Id], references: [id])
  player2      Player @relation("live_game_player2", fields: [player2Id], references: [id])
  turns        Turn[]
  gameCards    GameCard[]
}

model Turn {
  id          String  @id @default(uuid())
  gameId      String
  playerId    String
  turnNumber  Int
  phases      TurnPhase[]
  createdAt   DateTime @default(now())

  game        LiveGame @relation(fields: [gameId], references: [id])
  player      Player @relation(fields: [playerId], references: [id])
}

model TurnPhase {
  id          String  @id @default(uuid())
  turnId      String
  playerId    String
  phase       String  // "Draw", "Deployment", "Attack", "End"
  action      String  // What happened in this phase? (e.g., "Drew 1 card", "Deployed Fire Dragon")
  target      String? // If applicable, which card/player was affected?
  createdAt   DateTime @default(now())

  turn        Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  player      Player @relation(fields: [playerId], references: [id]) // Opposite relation added
}

model Deck {
  id        String @id @default(uuid())
  playerId  String
  name      String
  cards     DeckCard[]

  player    Player @relation(fields: [playerId], references: [id])
}

model Card {
  id         String  @id @default(uuid())
  name       String  @unique
  type       String  // "hero" or "creature"
  health     Int
  temperament String? // "Sanguine", "Phlegmatic", "Choleric", "Melancholic"
  imageUrl   String
  abilities  CardAbility[]

  decks      DeckCard[]
  gameCards  GameCard[]
}

model DeckCard {
  id       String @id @default(uuid())
  deckId   String
  cardId   String
  quantity Int @default(1)

  deck     Deck @relation(fields: [deckId], references: [id])
  card     Card @relation(fields: [cardId], references: [id])
}

model Ability {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  trigger     String  // "onRecruit", "onBattleStart", "onWin", etc.

  cardAbilities CardAbility[]
  gameCardAbilities GameCardAbility[]
}

model CardAbility {
  id             String  @id @default(uuid())
  cardId         String
  abilityId      String

  card           Card @relation(fields: [cardId], references: [id])
  ability        Ability @relation(fields: [abilityId], references: [id])

  @@unique([cardId, abilityId]) // Prevent duplicate abilities on the same card
}

model GameCard {
  id         String  @id @default(uuid())
  gameId     String
  cardId     String
  ownerId    String
  health     Int
  abilities  GameCardAbility[]

  game      LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  card      Card @relation(fields: [cardId], references: [id])
  owner     Player @relation(fields: [ownerId], references: [id])
}

model GameCardAbility {
  id           String  @id @default(uuid())
  gameCardId   String
  abilityId    String
  used         Boolean @default(false)

  gameCard     GameCard @relation(fields: [gameCardId], references: [id], onDelete: Cascade)
  ability      Ability @relation(fields: [abilityId], references: [id])
}

model CompletedMatch {
  id         String  @id @default(uuid())
  player1Id  String
  player2Id  String
  winnerId   String?
  gameData   Json  // Store final match state instead of linking LiveGame
  createdAt  DateTime @default(now())

  player1    Player @relation("completed_match_player1", fields: [player1Id], references: [id])
  player2    Player @relation("completed_match_player2", fields: [player2Id], references: [id])
}